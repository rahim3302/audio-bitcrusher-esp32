{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.includePath": ["${workspaceFolder}/include"],
  "files.exclude": { "**/*.o": true },
  "search.exclude": { "build": true },
  "code-runner.executorMap": {
    "c": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run.ps1\""
  },
  "code-runner.saveAllFilesBeforeRun": true,
  "code-runner.ignoreSelection": true,
  "code-runner.runInTerminal": true
}
